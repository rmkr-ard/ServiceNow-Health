        <operation_script><![CDATA[(function process(/*RESTAPIRequest*/ request, /*RESTAPIResponse*/ response) {

    var empty = "Cannot insert empty values!";
	var userEmpty = "Primary insured cannot be empty";
	var data = request.body.data;
	var primaryInsured = data.name;
	var output = {};

	if(data){
		gs.info(empty);
		output.message = empty;
	}
	else {

		var depUtil = new x_1806928_health_0.DependentUtil();
		var user = depUtil.returnSysID(primaryInsured);

		if(user){
			var grDependent = new GlideRecord("x_1806928_health_0_dependents_info");
			grDependent.initialize();
		}
		else{
			gs.info(userEmpty);
			output.message = userEmpty;
		}

	}

})(request, response);]]></operation_script>
